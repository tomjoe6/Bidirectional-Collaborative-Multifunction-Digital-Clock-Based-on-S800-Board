# S800 Smart Clock PC Application Configuration
# Copy this file to .env and modify as needed

# Default serial port (auto-detected if not set)
# DEFAULT_PORT=COM3

# Default baud rate
# DEFAULT_BAUD=115200

# =========================================================================
# E1: NTP Time Synchronization
# =========================================================================
# NTP server address (default: ntp.aliyun.com)
NTP_SERVER=ntp.aliyun.com
# NTP request timeout in seconds (default: 3)
NTP_TIMEOUT=3

# =========================================================================
# E2: Weather API Configuration
# =========================================================================
# Weather API type: "openweathermap" or "hefeng"
WEATHER_API_TYPE=openweathermap
# Your API key (required)
#   OpenWeatherMap: sign up at https://openweathermap.org/api for a free key
#   Hefeng (和风天气): sign up at https://dev.qweather.com/ for a free key
WEATHER_API_KEY=your_api_key_here
# Location identifier
#   OpenWeatherMap: city name (e.g. "Shanghai,CN" or "Beijing")
#   Hefeng: location ID (e.g. "101010100" for Beijing)
WEATHER_LOCATION=Shanghai,CN
# Cache TTL in seconds (default: 1800 = 30 minutes)
WEATHER_CACHE_TTL=1800
